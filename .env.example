# Clave local para firmar la cookie de sesión.
# No es un secreto de producción ni una credencial de Dynamics 365.
# En un despliegue real debe reemplazarse por un valor privado de al menos 16 caracteres.
SESSION_SECRET=desarrollo-local-terra-portal-no-usar-en-produccion

# Milisegundos de espera artificial en las rutas internas. 0 la desactiva.
SIMULATED_LATENCY_MS=0
